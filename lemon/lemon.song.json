  "map": {
    "whyTitle": "为什么值得逐句拆开听",
    "whySub": "四个理由，按重要性排",
    "why": [
      {
        "t": "否定形全家桶",
        "d": "戻らない、言えずに、帰れない、忘れられない、ありはしない。可能形否定、文言否定、双重否定全在同一首歌里。"
      },
      {
        "t": "「〜さえ」两次出现",
        "d": "「悲しみさえ」「苦しみさえ」——连悲伤都爱，是整首歌的核心逻辑。さえ 在这里不是「连…都」，是「连…也不例外」。"
      },
      {
        "t": "句尾决定生死",
        "d": "「でしょう」「ください」「できない」「確か」。四个句尾四种语气：推测、请求、能力否定、确认。学会听句尾，就听懂了一半。"
      },
      {
        "t": "词汇日常但用法深",
        "d": "夢、埃、匂い、果実、光，全是 N4 词。难的是它们被放在什么句子里——「夢にみる」「埃を払う」都是固定搭配。"
      }
    ]
  },
  "steps": [
    {
      "k": "STEP 01",
      "t": "先听，记住副歌两句",
      "d": "「あの日の悲しみさえ／あの日の苦しみさえ」两句结构完全一样，先把这一对记住，再听主歌。"
    },
    {
      "k": "STEP 02",
      "t": "再读，专挑否定",
      "d": "用逐句精读，把所有带「ない／ず／れない」的句子挑出来。否定形读顺了，整首歌的语速就跟得上了。"
    },
    {
      "k": "STEP 03",
      "t": "最后整段跟唱",
      "d": "副歌最后一句「今でもあなたはわたしの光」重复三次，每次前面的句子都不同。跟着原曲唱，注意最后一遍的「切り分けた果実」。"
    }
  ],
