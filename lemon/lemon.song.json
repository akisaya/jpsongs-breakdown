  "grammar": [
    {
      "p": "〜ならば",
      "sub": "假定（书面）",
      "form": "名詞／普通形 ＋ ならば",
      "mean": "如果…的话",
      "eg": "夢ならばどれほどよかったでしょう",
      "examples": [
        {
          "jp": "雨[あめ]ならば中止[ちゅうし]だ。",
          "tr": "如果下雨就取消。"
        },
        {
          "jp": "君[きみ]が行[い]くならば、私[わたし]も行[い]く。",
          "tr": "如果你去，我也去。"
        }
      ],
      "warn": "「ならば」比「なら」书面，多用于演讲、歌词；日常会话直接用「なら」或「だったら」。"
    },
    {
      "p": "どれほど〜でしょう",
      "sub": "感叹式推测",
      "form": "どれほど ＋ 形容詞／動詞 ＋ でしょう",
      "mean": "该有多么…啊",
      "eg": "夢ならばどれほどよかったでしょう",
      "examples": [
        {
          "jp": "どれほど嬉[うれ]しかったでしょう。",
          "tr": "该有多开心啊。"
        },
        {
          "jp": "どれほど大変[たいへん]だったでしょう。",
          "tr": "该有多辛苦啊。"
        }
      ],
      "warn": "「どれほど」比「どんなに」书面；句尾用「でしょう」表推测兼感叹，不是疑问。"
    },
    {
      "p": "〜ように",
      "sub": "比况",
      "form": "名詞＋の／動詞普通形 ＋ ように",
      "mean": "像…一样",
      "eg": "忘れた物を取りに帰るように",
      "examples": [
        {
          "jp": "鳥[とり]のように飛[と]ぶ。",
          "tr": "像鸟一样飞。"
        },
        {
          "jp": "彼[かれ]が言[い]ったようにやる。",
          "tr": "照他说的那样做。"
        }
      ],
      "warn": "「ように」后接动词或形容词，「ような」后接名词；两者中文都译「像…」，接续不同。"
    },
    {
