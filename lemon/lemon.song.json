      "tr": "每次遇到无法承受的东西",
      "words": [
        [
          "受け止める",
          "うけとめる",
          "承受"
        ],
        [
          "出会う",
          "であう",
          "遇到"
        ],
        [
          "たび",
          "たび",
          "每次"
        ]
      ],
      "g": "<b>〜きれない</b>：无法完全…。受け止める→受け止めきれない。「〜たび」＝每次…都…。",
      "n": "「きれない」不是「不能」，是「做不完、承受不完」；比单纯的否定多一层容量不够。"
    },
    {
      "jp": "溢[あふ]れてやまないのは涙[なみだ]だけ",
      "tr": "止不住溢出来的，只有眼泪",
      "words": [
        [
          "溢れる",
          "あふれる",
          "溢出"
        ],
        [
          "やまない",
          "やまない",
          "不止"
        ],
        [
          "涙",
          "なみだ",
          "眼泪"
        ]
      ],
      "g": "<b>〜てやまない</b>：…个不停、止不住。常与感情动词搭配，如「願ってやまない」。",
      "n": "「溢れてやまない」是水满了往外流；「だけ」把范围收到只剩眼泪，别的都忍住了。"
    },
    {
      "jp": "わたしの知[し]らない横顔[よこがお]で",
      "tr": "用我从未见过的侧脸",
      "words": [
        [
          "知る",
          "しる",
          "知道"
        ],
        [
          "横顔",
          "よこがお",
          "侧脸"
        ]
      ],
      "g": "<b>〜の知らない＋名詞</b>：我所不知道的…。の 在这里代替「が」，是连体修饰的主语标记。",
      "n": "「横顔」是侧脸，不是正脸；用这个词，说明说话人只敢从侧面看，或者对方从没正眼看过她。"
    },
    {
      "jp": "涙[なみだ]にくれ 淋[さび]しさの中[なか]にいるなら",
      "tr": "如果你正泪流满面、陷在寂寞里的话",
      "words": [
        [
          "涙にくれる",
          "なみだにくれる",
          "泪流满面"
        ],
        [
          "淋しさ",
          "さびしさ",
          "寂寞"
        ],
        [
          "なら",
          "なら",
          "如果"
        ]
      ],
      "g": "<b>涙に暮れる／くれる</b>：以泪洗面。这里用「くれ」，是「暮れる」的文言形，表陷入某种状态。",
      "n": "「淋しさ」用「淋」不用「寂」，字形就带冷；这句是全曲唯一一次把对方写成也会孤独的人。"
    },
    {
      "jp": "わたしのことなどどうか 忘[わす]れてください",
      "tr": "请务必把我忘了吧",
      "words": [
        [
          "など",
          "など",
          "之类"
        ],
        [
          "どうか",
          "どうか",
          "请务必"
        ],
        [
          "忘れる",
          "わすれる",
          "忘记"
        ]
      ],
      "g": "<b>〜など</b> 把「わたしのこと」往下压；<b>どうか＋〜てください</b>：请务必…。",
      "n": "「どうか」是低头请求的语气，不是「无论如何」；越客气，越像在把自己推开。"
    },
    {
      "jp": "そんなことを心[こころ]から願[ねが]うほどに",
      "tr": "越是打心底这样祈愿——",
      "words": [
        [
          "心から",
          "こころから",
          "打心底"
        ],
        [
          "願う",
          "ねがう",
          "祈愿"
        ],
        [
          "ほどに",
          "ほどに",
          "越是…"
        ]
      ],
      "g": "<b>〜ほどに</b>：到了…的程度；越…越…。这里前接「願う」，表示愿望的强度。",
      "n": "「ほどに」后面没有接结果，直接进「今でもあなたはわたしの光」——越希望你忘了我，越说明我忘不了你。"
    },
    {
      "jp": "自分[じぶん]が思[おも]うより 恋[こい]をしていたあなたに",
      "tr": "对那个我爱得比自己想象更深的你",
      "words": [
        [
          "自分",
          "じぶん",
          "自己"
        ],
        [
          "思う",
          "おもう",
          "认为"
        ],
        [
          "恋をする",
          "こいをする",
          "恋爱"
        ]
      ],
      "g": "<b>〜より</b>：比…更。思うより＝比想象的更…。「恋をしていた」用过去持续，指那段时间一直在爱。",
      "n": "「自分が思うより」放在句首，是承认自己都没察觉；这句的宾语「あなたに」被推到句尾，悬着。"
    },
    {
      "jp": "あれから思[おも]うように 息[いき]ができない",
      "tr": "从那以后，我连呼吸都不能自如",
      "words": [
        [
          "あれから",
          "あれから",
          "从那以后"
        ],
        [
          "思うように",
          "おもうように",
          "如愿"
        ],
        [
          "息",
          "いき",
          "呼吸"
        ]
      ],
      "g": "<b>思うように〜ない</b>：不能如愿地…。「息ができない」是生理性的，不是比喻。",
      "n": "「思うように」不是「像想的那样」，是「如愿」；后面接否定，就是「不如愿」。"
    },
    {
      "jp": "あんなに側[そば]にいたのに まるで嘘[うそ]みたい",
      "tr": "明明那么近，却像假的",
      "words": [
        [
          "あんなに",
