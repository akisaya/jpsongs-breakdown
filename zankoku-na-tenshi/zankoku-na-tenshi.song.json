  "grammar": [
    {
      "p": "〜のように",
      "sub": "比况",
      "form": "名詞 ＋ のように ＋ 動詞／形容詞",
      "mean": "像…一样",
      "eg": "残酷な天使のように",
      "examples": [
        {
          "jp": "鳥[とり]のように空[そら]を飛[と]びたい。",
          "tr": "想像鸟一样在天空飞。"
        },
        {
          "jp": "氷[こおり]のように冷[つめ]たい手[て]だ。",
          "tr": "像冰一样冷的手。"
        }
      ],
      "warn": "「ように」后接动词或形容词，「ような」后接名词；两句都译「像…」，接续不能混。"
    },
    {
      "p": "命令形（なる→なれ）",
      "sub": "命令、呼告",
      "form": "五段：词尾变え段（なる→なれ）／一段：去る＋ろ／する→しろ／来る→来い",
      "mean": "成为…吧！",
      "eg": "少年よ 神話になれ",
      "examples": [
        {
          "jp": "早[はや]く来[こ]い。",
          "tr": "快点过来！"
        },
        {
          "jp": "静[しず]かにしろ。",
          "tr": "安静点！"
        }
      ],
      "warn": "命令形语气很强，只对平辈以下或敌人用；歌词里的「なれ」是呼告，不是日常请求。"
    },
    {
      "p": "〜ても",
      "sub": "让步",
      "form": "動詞て形 ＋ も",
      "mean": "即使…也",
      "eg": "蒼い風がいま 胸のドアを叩いても",
      "examples": [
        {
          "jp": "雨[あめ]が降[ふ]っても行[い]く。",
          "tr": "即使下雨也去。"
        },
        {
          "jp": "何度[なんど]失敗[しっぱい]しても諦[あきら]めない。",
          "tr": "无论失败多少次都不放弃。"
        }
      ],
      "warn": "动词用「ても」，名词用「でも」；不要写成「叩いても」之外的形式。"
    },
