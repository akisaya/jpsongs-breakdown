  "grammar": [
    {
      "p": "命令形",
      "sub": "命令、口令",
      "form": "五段：词尾变え段（書く→書け）／一段：去る＋ろ（食べろ）／する→しろ・せよ／来る→来い",
      "mean": "做…！（强硬命令）",
      "eg": "未来を裂け　名前を呼べ",
      "examples": [
        {
          "jp": "早[はや]く来[こ]い。",
          "tr": "快点过来！"
        },
        {
          "jp": "静[しず]かにしろ。",
          "tr": "安静点！"
        },
        {
          "jp": "自分[じぶん]で決[き]めろ。",
          "tr": "自己决定！"
        }
      ],
      "warn": "命令形只对平辈、下属或敌人用，对长辈会失礼；歌词里省掉「ろ」的「預け」「向け」更短、更硬。"
    },
    {
      "p": "〜始める",
      "sub": "动作开始",
      "form": "動詞ます形（去ます）＋始める",
      "mean": "开始…",
      "eg": "望まない僕の世界を 壊し始めた",
      "examples": [
        {
          "jp": "雨[あめ]が降[ふ]り始[はじ]めた。",
          "tr": "开始下雨了。"
        },
        {
          "jp": "彼[かれ]は急[きゅう]に笑[わら]い始[はじ]めた。",
          "tr": "他突然笑了起来。"
        }
      ],
      "warn": "「始める」是他动词：前接他动词时保留を（壊し始める），前接自动词时用が（降り始める）。"
    },
    {
      "p": "〜続ける",
      "sub": "持续、不停",
      "form": "動詞ます形（去ます）＋続ける",
      "mean": "一直…下去",
      "eg": "歩き続けた この軌跡/奇跡を",
      "examples": [
        {
          "jp": "彼[かれ]は三時間[さんじかん]走[はし]り続[つづ]けた。",
          "tr": "他连续跑了三个小时。"
        },
        {
          "jp": "考[かんが]え続[つづ]けても答[こた]えは出[で]ない。",
          "tr": "一直想下去也想不出答案。"
        }
      ],
      "warn": "「〜ている」是状态，「〜続ける」是意志性的持续；「歩き続ける」强调不停下来。"
    },
    {
      "p": "〜出す",
      "sub": "突然开始",
      "form": "動詞ます形（去ます）＋出す",
      "mean": "突然开始…；…出去",
      "eg": "歩き出した 僕の因果",
      "examples": [
        {
          "jp": "子[こ]どもが急[きゅう]に泣[な]き出[だ]した。",
          "tr": "孩子突然哭了起来。"
        },
        {
          "jp": "雨[あめ]が降[ふ]り出[だ]した。",
          "tr": "下起雨来了。"
        }
      ],
      "warn": "「〜出す」带「突然」的语感；「〜始める」只是开始，不一定突然。"
    },
    {
      "p": "〜たいの",
      "sub": "愿望＋柔和句尾",
      "form": "動詞ます形（去ます）＋たい ＋ の",
      "mean": "我想…（带解释、自问的语气）",
      "eg": "運命を変えたいの",
      "examples": [
        {
          "jp": "誰[だれ]にも言[い]いたくないの。",
          "tr": "我不想告诉任何人。"
        },
        {
          "jp": "もう少[すこ]し考[かんが]えたいの。",
          "tr": "我想再想一想。"
        }
      ],
      "warn": "「の」是终助词，不是疑问；只有语调上扬才变成问句。男性口吻常换成「んだ」。"
    },
    {
      "p": "〜から（句尾）",
      "sub": "理由、宣言",
      "form": "文 ＋ から（句尾）",
      "mean": "因为…（所以我会…）",
      "eg": "何度も振り解いて 今日を護るから",
      "examples": [
        {
          "jp": "私[わたし]が守[まも]るから。",
          "tr": "我会保护你的。"
        },
        {
          "jp": "先[さき]に帰[かえ]るから。",
          "tr": "我先回去了。"
        }
      ],
