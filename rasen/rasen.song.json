    {
      "jp": "歪[ゆが]んだ螺旋[らせん]に気付[きづ]いて",
      "tr": "察觉到那条扭曲的螺旋",
      "words": [
        [
          "歪む",
          "ゆがむ",
          "扭曲"
        ],
        [
          "螺旋",
          "らせん",
          "螺旋"
        ],
        [
          "気付く",
          "きづく",
          "察觉"
        ]
      ],
      "g": "<b>〜に気付く</b>：注意到某事。に 标记注意到的对象，不能用 を。",
      "n": "「螺旋」是标题，也是全曲的核心意象：命运不是直线，是越转越深的圈。唱到这个词要放慢半拍。"
    },
    {
      "jp": "歩[ある]き出[だ]した　僕[ぼく]の因果[いんが]",
      "tr": "开始迈步的，我的因果",
      "words": [
        [
          "歩き出す",
          "あるきだす",
          "迈步"
        ],
        [
          "僕",
          "ぼく",
          "我"
        ],
        [
          "因果",
          "いんが",
          "因果"
        ]
      ],
      "g": "<b>〜出す</b>：ます形去ます＋出す，表示动作突然开始，常与「歩く・走る・泣く」搭配。",
      "n": "「因果」在佛教里指原因与结果，也指宿命。这里不译「因果报应」，是「我自己的因与果」。"
    },
    {
      "jp": "希望[きぼう]を刈[か]った　手[て]を観[み]て",
      "tr": "看着这双收割了希望的手",
      "words": [
        [
          "希望",
          "きぼう",
          "希望"
        ],
        [
          "刈る",
          "かる",
          "收割"
        ],
        [
          "観る",
          "みる",
          "端详"
        ]
      ],
      "g": "<b>刈る</b>＝割（草、麦），引申为收割、夺走。「観て」＝端详、观赏，比「見て」多一层审视。",
      "n": "「刈った」配「希望」是农业隐喻：希望像麦子一样被一茬割掉。这个词比「奪った」更冷。"
    },
    {
      "jp": "奪[うば]って嗤[わら]って",
      "tr": "夺走，然后嗤笑",
      "words": [
        [
          "奪う",
          "うばう",
          "夺取"
        ],
        [
          "嗤う",
          "わらう",
          "嗤笑"
        ]
      ],
      "g": "<b>嗤う</b>＝嗤笑、冷笑，比「笑う」多一层轻蔑。字形从「口」，专门指嘴上的嘲笑。",
      "n": "「嗤って」和前面的「笑った」形成对照：第一次是笑，第二次是嗤。同一个动作，温度完全不同。"
    },
    {
      "jp": "何度[なんど]も振[ふ]りかざして　夜[よる]を告[つ]げるから",
      "tr": "一次次高高举起，因为我要宣告夜的到来",
      "words": [
        [
          "振りかざす",
          "ふりかざす",
          "高举挥动"
        ],
        [
          "夜",
          "よる",
          "夜"
        ],
        [
          "告げる",
          "つげる",
          "宣告"
        ]
      ],
      "g": "<b>振りかざす</b>＝把刀、旗高高举起挥动。<b>告げる</b>＝宣告、告知，比「言う」正式。",
      "n": "「振りかざして」比前面的「掲げる」更暴力：举起的不再是声音，是要落下的东西。"
    },
    {
      "jp": "正義[せいぎ]と正義[せいぎ]が阻[はば]む先[さき]をお前[まえ]らに問[と]う",
      "tr": "正义与正义互相阻挡的前方——我问你们",
      "words": [
        [
          "正義",
          "せいぎ",
          "正义"
        ],
        [
          "阻む",
          "はばむ",
          "阻挡"
        ],
        [
          "先",
          "さき",
          "前方"
        ],
        [
          "問う",
          "とう",
          "质问"
        ]
      ],
      "g": "<b>お前ら</b>：お前＋ら，把单数变复数，语气粗，只对平辈以下用。「問う」是书面语的质问，不带商量余地。",
      "n": "两个「正義」并列，是整首歌的题眼：不是善与恶，是两种正义互相卡住。唱的时候两个正義要一样重。"
    },
    {
      "jp": "さぁ選[えら]べ",
      "tr": "来吧，选吧",
      "words": [
        [
          "さぁ",
          "さぁ",
          "来吧"
        ],
        [
          "選ぶ",
          "えらぶ",
          "选择"
        ]
      ],
      "g": "<b>命令形</b>：選ぶ（五段）→ ぶ变べ → 選べ。「さぁ」是催促，带「来吧」的挑衅感。",
      "n": "全曲最后一个命令形。前面都是「我」在动，这一句把选择推给对方。"
    }
  ],
