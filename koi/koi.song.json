  "map": {
    "whyTitle": "为什么值得逐句拆开听",
    "whySub": "四个理由，按重要性排",
    "why": [
      {
        "t": "名词句的教科书",
        "d": "「胸の中にあるもの」「距離の中にある鼓動」「夫婦を超えてゆけ」。全曲几乎没有完整主谓句，靠名词和命令形把情绪堆起来。"
      },
      {
        "t": "「〜ずにいられない」只出现一次",
        "d": "「恋せずにいられないな」是全曲唯一的否定＋补偿句型，学会这一句，等于掌握「忍不住要…」的固定说法。"
      },
      {
        "t": "书面词混口语",
        "d": "営み、群れ、鼓動、虚構、白鳥。这些词日常很少说，却和「なんか」「ただ」「ふと」这样的口语混在一起，是星野源特有的语体。"
      },
      {
        "t": "节奏适合跟跳",
        "d": "副歌八句一循环，每句四到六拍。恋舞的拍点就落在「胸の中にあるもの」这种短句上，边跳边唱最容易记住。"
      }
    ]
  },
  "steps": [
    {
      "k": "STEP 01",
      "t": "先听，找副歌的循环",
      "d": "副歌从「胸の中にあるもの」开始，八句一循环，出现三次。先记住这八句的顺序，再看主歌。"
    },
    {
      "k": "STEP 02",
      "t": "再读，补齐省略的主语",
      "d": "用逐句精读，把每句省略的主语补出来：谁在运？谁在归？谁在超？补完一次，句意就顺了。"
    },
    {
      "k": "STEP 03",
      "t": "最后跟着唱整段",
      "d": "副歌句尾全是「の／こと／て」这种轻音，跟着原曲唱，注意不要把「夫婦を超えてゆけ」唱成「ふうふをこえてゆけ」的平板调。"
    }
  ],
