    {
      "p": "〜から（起点）",
      "sub": "从…开始",
      "form": "名詞 ＋ から",
      "mean": "从…开始",
      "eg": "この世にいる誰も 二人から",
      "examples": [
        {
          "jp": "一[ひと]つから始[はじ]めよう。",
          "tr": "从一个开始吧。"
        },
        {
          "jp": "駅[えき]から歩[ある]いて十分[じゅっぷん]だ。",
          "tr": "从车站走十分钟。"
        }
      ],
      "warn": "「から」表起点，也可以表原因；要看他后面接的是场所、时间还是判断。"
    },
    {
      "p": "〜なくなる",
      "sub": "变得不…",
      "form": "形I去い＋く＋なる／動詞ない形＋なくなる",
      "mean": "变得不…",
      "eg": "いつか見えなくなるもの",
      "examples": [
        {
          "jp": "痛[いた]みがなくなった。",
          "tr": "不疼了。"
        },
        {
          "jp": "彼[かれ]は来[こ]なくなった。",
          "tr": "他不来了。"
        }
      ],
      "warn": "形容词用「く＋なる」，动词用「なく＋なる」；不要写成「見えないなる」。"
    },
    {
      "p": "〜ずにいられない",
      "sub": "忍不住",
      "form": "動詞ない形去ない ＋ ずにいられない（する→せずにいられない）",
      "mean": "忍不住要…；不…就受不了",
      "eg": "恋せずにいられないな",
      "examples": [
        {
          "jp": "笑[わら]わずにいられない。",
          "tr": "忍不住笑。"
        },
        {
          "jp": "考[かんが]えずにいられない。",
          "tr": "忍不住去想。"
        }
      ],
      "warn": "「する」要变成「せず」，不是「しず」；这是文言否定，语气比「ないで」硬。"
    },
    {
      "p": "〜ながら",
      "sub": "同时进行",
      "form": "動詞ます形（去ます）＋ながら",
      "mean": "一边…一边…",
      "eg": "当たり前を変えながら",
      "examples": [
        {
          "jp": "歌[うた]いながら歩[ある]く。",
          "tr": "一边唱歌一边走。"
        },
        {
          "jp": "働[はたら]きながら勉強[べんきょう]する。",
          "tr": "一边工作一边学习。"
        }
      ],
      "warn": "「ながら」前后必须是同一主语；前后主语不同时不能用。"
    },
    {
      "p": "〜も〜も",
      "sub": "并列、全部",
      "form": "名詞 ＋ も ＋ 名詞 ＋ も",
      "mean": "…也…也；都",
      "eg": "泣き顔も 黙る夜も",
      "examples": [
        {
          "jp": "雨[あめ]も風[かぜ]も強[つよ]い。",
          "tr": "雨也大，风也大。"
        },
        {
          "jp": "彼[かれ]も私[わたし]も行[い]く。",
          "tr": "他也去，我也去。"
        }
      ],
      "warn": "「も」叠用表示「全都包括」；不要和表示「也」的单独「も」混。"
    },
