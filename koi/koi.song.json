  "grammar": [
    {
      "p": "〜たら",
      "sub": "条件、时候",
      "form": "動詞た形 ＋ ら",
      "mean": "一…就…；等到…的时候",
      "eg": "街が暮れたら色めき",
      "examples": [
        {
          "jp": "春[はる]になったら花[はな]が咲[さ]く。",
          "tr": "一到春天花就开。"
        },
        {
          "jp": "家[いえ]に帰[かえ]ったら電話[でんわ]して。",
          "tr": "到家了给我打电话。"
        }
      ],
      "warn": "「たら」比「と」口语，条件感也更强；后项常是说话人的判断或请求。"
    },
    {
      "p": "〜てゆく（ていく）",
      "sub": "向未来持续",
      "form": "動詞て形 ＋ ゆく",
      "mean": "…下去",
      "eg": "夫婦を超えてゆけ",
      "examples": [
        {
          "jp": "これからも歩[ある]いてゆく。",
          "tr": "今后也会继续走下去。"
        },
        {
          "jp": "少[すこ]しずつ変[か]わってゆく。",
          "tr": "一点一点变化下去。"
        }
      ],
      "warn": "「ゆく」是「いく」的书面形；命令形「ゆけ」带号召感，不能用在日常请求里。"
    },
    {
      "p": "〜わ（終助詞）",
      "sub": "柔和断定",
      "form": "文 ＋ わ",
      "mean": "…呀；…呢",
      "eg": "風たちは運ぶわ",
      "examples": [
        {
          "jp": "私[わたし]も行[い]くわ。",
          "tr": "我也去哦。"
        },
        {
          "jp": "今日[きょう]は寒[さむ]いわ。",
          "tr": "今天真冷啊。"
        }
      ],
      "warn": "「わ」多为女性或柔和口吻；男性用会显得做作，正式场合也不用。"
    },
    {
      "p": "〜なんか",
      "sub": "轻蔑、自谦",
      "form": "名詞 ＋ なんか（＝など）",
      "mean": "…什么的",
      "eg": "意味なんか ないさ",
      "examples": [
        {
          "jp": "お金[かね]なんか要[い]らない。",
          "tr": "钱什么的我不需要。"
        },
        {
          "jp": "私[わたし]なんかまだまだです。",
          "tr": "我这种人还差得远。"
        }
      ],
      "warn": "「なんか」把对象往下压；不要和「何か」（某物）混，读音相同但用法不同。"
    },
    {
      "p": "〜だけ",
      "sub": "限定",
      "form": "名詞／普通形 ＋ だけ",
      "mean": "只…；仅仅…",
      "eg": "暮らしがあるだけ",
      "examples": [
        {
          "jp": "水[みず]だけ飲[の]んだ。",
          "tr": "只喝了水。"
        },
        {
          "jp": "見[み]ているだけでも楽[たの]しい。",
          "tr": "光是看着也开心。"
        }
      ],
      "warn": "「だけ」是肯定限定，「しか〜ない」是否定限定；两者不能直接互换。"
    },
    {
      "p": "腹を空かせる",
      "sub": "惯用句",
      "form": "腹 ＋ を ＋ 空かせる",
      "mean": "饿着肚子",
      "eg": "ただ腹を空かせて",
      "examples": [
        {
          "jp": "腹[はら]を空[あ]かせて帰[かえ]ってきた。",
          "tr": "饿着肚子回来了。"
        },
        {
          "jp": "腹[はら]を空[あ]かせて待[ま]っている。",
          "tr": "饿着肚子等着。"
        }
      ],
      "warn": "日常更常说「お腹が空く」；「腹を空かせる」是他动词形，语气更粗、更有动作感。"
    },
    {
      "p": "〜んだ（のだ）",
      "sub": "解释、决心",
      "form": "普通形 ＋ んだ（＝のだ）",
      "mean": "（其实）是…；就要…",
      "eg": "君の元へ帰るんだ",
      "examples": [
        {
          "jp": "明日[あした]は早[はや]く起[お]きるんだ。",
          "tr": "明天要早起。"
        },
        {
          "jp": "実[じつ]は行[い]きたくなかったんだ。",
          "tr": "其实我本来不想去。"
        }
      ],
      "warn": "「んだ」不是过去形，是「のだ」的缩约；句尾下沉时多表决心或解释。"
    },
    {
      "p": "〜ことが",
      "sub": "名词化＋主语",
      "form": "文 ＋ ことが ＋ 述語",
      "mean": "…这件事",
      "eg": "見上げて思うことが",
      "examples": [
        {
          "jp": "気付[きづ]いたことがある。",
          "tr": "我注意到一件事。"
        },
        {
          "jp": "彼[かれ]が言[い]ったことが正[ただ]しい。",
          "tr": "他说的事是对的。"
        }
      ],
      "warn": "「こと」把句子名词化，が 标记主语；不要把它当成「事情」硬译。"
