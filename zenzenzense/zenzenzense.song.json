    {
      "p": "〜かい",
      "sub": "口语疑问终助词",
      "form": "普通形＋かい（男性用语）",
      "mean": "…吗？（带亲昵或居高临下的语气）",
      "eg": "やっと眼を覚ましたかい",
      "examples": [
        {
          "jp": "元気[げんき]かい?",
          "tr": "你还好吗？"
        },
        {
          "jp": "もう食[た]べたかい?",
          "tr": "已经吃了吗？"
