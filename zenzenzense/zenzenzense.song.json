  "map": {
    "whyTitle": "为什么值得逐句拆开听",
    "whySub": "四个理由，按重要性排",
    "why": [
      {
        "t": "数量词的夸张用法",
        "d": "何億・何光年分・銀河何個分か——「何＋量词」表示不确定的大数，「〜分」表示「相当于…的量」。这一组是日语里表达「不可计数」的固定套路。"
      },
      {
        "t": "「〜てくる」出现了六次",
        "d": "飛ばしてきた、追い越してきた、やってきた、語りにきた。全部「朝着说话人这边过来」，方向感是这句歌词的骨架。"
      },
      {
        "t": "「〜たって」＝即使",
        "d": "なくなって…チリヂリになったって。口语的「たって」等于「ても」，比「ても」更随意，歌里用得极多。"
      },
      {
        "t": "口语终助词密集",
        "d": "かい、だい、さ、か。四个句尾助词决定语气：疑问、反问、轻断言、自问。日文歌的「口气」几乎全靠它们。"
      }
    ]
  },
  "steps": [
    {
      "k": "STEP 01",
      "t": "先听，记住三段副歌",
      "d": "「君の前前前世から僕は」一共出现三次，第二、三次前面换了词。先把这三处的位置记住，长歌就不乱。"
    },
    {
      "k": "STEP 02",
      "t": "再读，专挑数量词",
      "d": "何億、何光年分、銀河何個分か、1から、0から。把这几处圈出来，看它们怎么把「时间」变成可以数的东西。"
    },
    {
      "k": "STEP 03",
      "t": "最后跟唱「〜てきた」",
      "d": "副歌每句都以「てきた」「てきたよ」收尾。跟着原曲唱，注意「きた」不要唱成「きだ」。"
    }
  ],
