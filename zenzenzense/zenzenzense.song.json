      "jp": "何億[なんおく] 何光年分[なんこうねんぶん]の物語[ものがたり]を語[かた]りにきたんだよ",
      "tr": "是为了讲述几亿、几光年那么长的故事才来的啊",
      "words": [
        [
          "何億",
          "なんおく",
          "几亿"
        ],
        [
          "光年",
          "こうねん",
          "光年"
        ],
        [
          "物語",
          "ものがたり",
          "故事"
        ],
        [
          "語る",
          "かたる",
          "讲述"
        ]
      ],
      "g": "<b>何＋量词</b>：表示不确定的大数，如 何億、何十人、何百回。<b>〜分</b>：相当于…的量，何光年分＝相当于多少光年的量。",
      "n": "「語りにきた」＝为了讲而来。「ます形去ます＋に来る」表示来做的目的，如 食べに来る、見に来る。"
    },
    {
      "jp": "けどいざその姿[すがた]この眼[め]に映[うつ]すと",
      "tr": "可一旦真的把你的身影映进眼里",
      "words": [
        [
          "いざ",
          "いざ",
          "一旦；到了跟前"
        ],
        [
          "姿",
          "すがた",
          "身影；样子"
        ],
        [
          "映す",
          "うつす",
          "映照"
        ]
      ],
      "g": "<b>いざ〜と</b>：「一旦真的…就」。表示从准备状态进入实际状态的那个转折点。",
      "n": "这句在语法上是半句，后面接的是下一段的「戯れたいよ」。歌词断行不等于句子结束。"
    },
    {
      "jp": "君[きみ]も知[し]らぬ君[きみ]とジャレて 戯[たわむ]れたいよ",
      "tr": "想和连你自己都不认识的你打打闹闹",
      "words": [
        [
          "知らぬ",
          "しらぬ",
          "不知道（文语否定）"
        ],
        [
          "ジャレる",
          "じゃれる",
          "打闹；嬉闹"
        ],
        [
          "戯れる",
          "たわむれる",
          "玩耍；戏耍"
        ]
      ],
      "g": "<b>知らぬ</b>：＝知らない，文语否定「ぬ」保留在连体修饰里，书面感强。修饰名词时必须用「ぬ」。",
      "n": "「ジャレて」和「戯れたい」是同一个意思的重复：先说口语版，再说书面版，节奏上更有弹性。"
    },
    {
      "jp": "君[きみ]の消[き]えぬ痛[いた]みまで愛[あい]してみたいよ",
      "tr": "连你那些消不掉的痛，我都想一并去爱",
      "words": [
        [
          "消える",
          "きえる",
          "消失"
        ],
        [
          "痛み",
          "いたみ",
          "疼痛"
        ],
        [
          "愛する",
          "あいする",
          "爱"
        ]
      ],
      "g": "<b>〜まで</b>：连…都。这里把「痛み」也纳入「愛す」的范围，是程度上的扩张。",
      "n": "「消えぬ」＝消えない，同上一张卡的「知らぬ」。这个词尾在歌词里反复出现，是文语残留。"
    },
    {
      "jp": "銀河[ぎんが]何個分[なんこぶん]かの 果[は]てに出逢[であ]えた",
      "tr": "在相当于好几个银河的尽头，终于遇见了你",
      "words": [
        [
          "銀河",
          "ぎんが",
          "银河"
        ],
        [
          "何個分",
          "なんこぶん",
          "相当于几个"
        ],
        [
          "果て",
          "はて",
          "尽头"
        ],
        [
          "出逢う",
          "であう",
          "相遇"
        ]
      ],
      "g": "<b>何個分か</b>：「几个那么多」，「か」表示不确定。注意「分」在这里读「ぶん」。",
      "n": "「出逢う」比「会う」重，带命运感。歌词、小说里写命中注定的相遇时才用。"
    },
    {
      "jp": "その手[て]を壊[こわ]さずに どう握[にぎ]ったならいい?",
      "tr": "那只手，要怎么握才不会弄坏？",
      "words": [
        [
          "壊す",
          "こわす",
          "弄坏"
        ],
        [
          "握る",
          "にぎる",
          "握"
        ],
        [
          "〜ずに",
          "ずに",
          "不…而"
        ]
      ],
      "g": "<b>〜ずに</b>：＝〜ないで，书面色彩。「壊さずに」＝不弄坏地。<b>〜たなら</b>：「如果…的话」，比「たら」更假设。",
      "n": "「壊さずに握る」这个搭配很妙：把「握手」写成怕碰坏瓷器。中文很难直译出这层小心。"
    },
    {
      "jp": "そんな革命前夜[かくめいぜんや]の僕[ぼく]らを誰[だれ]が止[と]めるというんだろう",
      "tr": "处在革命前夜的我们，还有谁能拦得住呢",
      "words": [
        [
          "革命",
          "かくめい",
          "革命"
        ],
        [
          "前夜",
          "ぜんや",
          "前夜"
        ],
        [
          "止める",
          "とめる",
          "阻止"
        ]
      ],
      "g": "<b>誰が〜というんだろう</b>：反问句式，「谁会…呢」＝没人会。语气比直接否定强。",
      "n": "「というんだろう」不是引用，是反问的固定壳。写议论文时也能用：誰が予想できたというのだろう。"
    },
    {
      "jp": "君[きみ]は僕[ぼく]から諦[あきら]め方[かた]を 奪[うば]い取[と]ったの",
      "tr": "是你，把「放弃」这个方法从我这里夺走了",
      "words": [
        [
          "諦める",
          "あきらめる",
          "放弃"
        ],
        [
          "諦め方",
          "あきらめかた",
          "放弃的方法"
        ],
        [
          "奪い取る",
          "うばいとる",
          "夺走"
        ]
      ],
      "g": "<b>奪い取る</b>：奪う＋取る，双重强调「抢过来」。句尾「の」是说明语气，带一点撒娇的断定。",
      "n": "「諦め方」＝放弃的方法。日语很爱用「〜方」把动作名词化，这里把抽象动作变成一个可以被夺走的「东西」。"
    },
    {
      "jp": "言[い]ったろう? 二人[ふたり]なら",
      "tr": "我说过了吧？只要两个人一起",
      "words": [
        [
          "言った",
          "いった",
          "说了"
        ],
        [
          "ろう",
          "ろう",
          "…吧（确认）"
        ],
        [
          "二人",
          "ふたり",
          "两个人"
        ]
      ],
      "g": "<b>〜ただろう／〜たろう</b>：不是推测，是「我说过了吧」的确认，带一点得意。<b>〜なら</b>：既然／如果是…的话，承接条件。",
      "n": "「ろう」在这里是把已经说过的话再确认一遍。语气上扬，等于中文的「我不是说了吗」。"
    },
    {
      "jp": "君[きみ]以外[いがい]の武器[ぶき]は 他[ほか]にはいらないんだ",
      "tr": "除了你以外的武器，我一个都不需要",
      "words": [
        [
          "以外",
          "いがい",
          "以外"
        ],
        [
          "武器",
          "ぶき",
          "武器"
        ],
        [
          "いらない",
          "いらない",
          "不需要"
        ]
      ],
      "g": "<b>〜以外</b>：除了…之外。<b>〜んだ</b>：说明语气，把前面的话收成一个结论。",
      "n": "「他にはいらない」＝除了这个别的都不要。日语里「他には」常和否定呼应，表示排他。"
    },
    {
      "jp": "何光年[なんこうねん]でも この歌[うた]を口[くち]ずさみながら",
      "tr": "不管多少光年，都一边哼着这首歌",
      "words": [
        [
          "何光年でも",
          "なんこうねんでも",
          "不管多少光年"
        ],
        [
          "口ずさむ",
          "くちずさむ",
          "哼唱"
        ],
        [
          "〜ながら",
          "ながら",
          "一边…一边"
        ]
      ],
      "g": "<b>何〜でも</b>：「不管多少…都」。疑问词＋でも表示全称。<b>〜ながら</b>：两个动作同时进行，主语必须相同。",
      "n": "全曲最后一句停在「ながら」，句子没有收尾，是故意的：故事还在继续。"
    }
  ],
