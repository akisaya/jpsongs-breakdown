  "map": {
    "whyTitle": "从语言的摆动进入这首歌",
    "whySub": "四个值得留意的听读线索",
    "why": [
      {
        "t": "口语缩约里藏着语法",
        "d": "「ばっか」是「ばかり」的口语形式，「ぜ」带粗犷的劝诱语气；先还原，再听它们如何贴合节拍。"
      },
      {
        "t": "古风词与现代口语并置",
        "d": "「宵闇」「花曇り」「にべもなし」营造旧式画面；不要把所有写法都照搬进日常对话。"
      },
      {
        "t": "拟态语需要连同节奏记忆",
        "d": "「ふらふら」有摇晃、不稳定的感觉，「へらへら」则常形容不严肃地笑。长音和拍点都要听清。"
      },
      {
        "t": "情绪留有解释空间",
        "d": "艳丽意象、离别与嫉妒交叠；先理解词义，再尝试用自己的话描述人物关系，不必把一种解读当成标准答案。"
      }
    ]
  },
  "steps": [
    {
      "k": "STEP 01",
      "t": "先听颜色与节奏",
      "d": "先听正版音源，留意晃动的拟态语、突然收住的句尾，以及画面感很强的名词。"
    },
    {
      "k": "STEP 02",
      "t": "再读，一句一句拆开",
      "d": "用下面的逐句精读先找准每句话的主干，再看古风词、口语缩约和句尾如何一起推动语气。"
    },
    {
      "k": "STEP 03",
      "t": "用原创例句迁移",
      "d": "在词表勾选已掌握的词，再展开语法图谱，跟读例句并试着换一个生活场景造句。"
    }
  ],
