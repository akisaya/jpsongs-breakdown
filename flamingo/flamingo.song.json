  "lines": [
    {
      "jp": "宵闇[よいやみ]",
      "tr": "黄昏后的暮色",
      "words": [
        [
          "宵闇",
          "よいやみ",
          "入夜时的昏暗"
        ]
      ],
      "g": "<b>名词意象</b>：宵是入夜不久，闇是黑暗；合起来描绘刚刚入夜时的朦胧。",
      "n": "这是偏文学的时间与光线描写，和普通说法「夜」的色彩不同。"
    },
    {
      "jp": "爪弾[つまはじ]き",
      "tr": "排斥、嫌弃",
      "words": [
        [
          "爪弾き",
          "つまはじき",
          "排斥；受排斥"
        ]
      ],
      "g": "<b>名词化表达</b>：「爪弾きにする」表示把人排斥在外，也可作名词使用。",
      "n": "注意读作「つまはじき」；另一个同形词「つまびき」可以指弹拨乐器。"
    },
    {
      "jp": "花曇[はなぐも]り",
      "tr": "花季的阴天",
      "words": [
        [
          "花曇り",
          "はなぐもり",
          "樱花时节的阴天"
        ]
      ],
      "g": "<b>复合名词</b>：「花」在季节语境中常指樱花；「曇り」是阴天。",
      "n": "这是带季节感的书面词，并不只是任何花朵下的阴天。"
    },
    {
      "jp": "にべもなし",
      "tr": "冷淡无情；毫不通融",
      "words": [
        [
          "にべもない",
          "にべもない",
          "冷淡；不通融"
        ]
      ],
      "g": "<b>文语句尾</b>：「なし」对应现代语的「ない」；整体形容态度冷淡、不留余地。",
      "n": "不要把它理解成普通的「没有」；整词使用，语体偏文学。"
    },
    {
      "jp": "侘[わ]びしげに",
      "tr": "显得寂寥地",
      "words": [
        [
          "侘びしい",
          "わびしい",
          "寂寥；凄清"
        ],
        [
          "〜げ",
          "げ",
          "看起来……"
        ]
      ],
      "g": "<b>形容词词干＋げ</b>：表示从外观看起来有某种情绪或样子；「に」让它修饰动作。",
      "n": "这是从外部观察到的样子，并不是说话者直接断言对方内心。"
    },
    {
      "jp": "泥仕合[どろじあい]",
      "tr": "互相抹黑的争斗",
      "words": [
        [
          "泥仕合",
          "どろじあい",
          "丑陋的争斗"
        ]
      ],
      "g": "<b>名词</b>：原指沾满泥的比赛，常比喻双方都失体面的争执。",
      "n": "比喻义常带贬义；不是单纯指在泥地里打架。"
    },
    {
      "jp": "触[さわ]りたい",
      "tr": "想触碰",
      "words": [
        [
          "触る",
          "さわる",
          "触碰"
        ],
        [
          "〜たい",
          "たい",
          "想要做……"
        ]
      ],
      "g": "<b>ます形去ます＋たい</b>：表达说话者想做某事，活用方式类似い形容词。",
      "n": "「たい」描述愿望；表达对方愿望时通常要结合观察或转述。"
    },
    {
      "jp": "踊[おど]るまま",
      "tr": "就这样跳着舞",
      "words": [
        [
          "踊る",
          "おどる",
